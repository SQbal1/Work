# Copy to .env.local and fill in. All NEXT_PUBLIC_* vars are exposed to the browser.

# Canonical public origin — used for SEO metadata, Open Graph, robots.txt, sitemap.xml.
# Defaults to brand.url (https://placeholder.sa) when unset.
NEXT_PUBLIC_SITE_URL=https://placeholder.sa

# Analytics → PostHog Cloud (EU region — recommended for GCC data posture).
# Project API key: PostHog dashboard → Project Settings → Project API key.
# When unset, PostHog does not initialize and track() is a no-op — so local
# dev and CI previews load nothing.
# NOTE: NEXT_PUBLIC_* vars are inlined at BUILD time. Set these in your
# Netlify/Vercel build environment, not only in .env.local.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API host. Defaults to /ingest — the same-origin reverse proxy in
# next.config.mjs (bypasses ad-blockers). Set to https://eu.i.posthog.com to
# connect directly and skip the proxy.
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Pilot request form → Formspree.
# Create a free form at https://formspree.io, then paste ONLY the id part of the
# endpoint URL (https://formspree.io/f/<this-part>). When unset, the pilot form
# falls back to a local success message and does not send anything.
NEXT_PUBLIC_FORMSPREE_ID=xvzjkayy

# Supabase — backend (Postgres + Auth). Project settings → API.
# Either the legacy "anon" JWT key or the newer sb_publishable_... key works —
# tested and confirmed working with the legacy JWT format below.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
